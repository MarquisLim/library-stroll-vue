# Separate Docker environment. Never copy OpenServer's .env over this file.
COMPOSE_PROJECT_NAME=library-stroll-docker
DOCKER_OLLAMA_MODE=host
APP_NAME=LibraryStroll
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8088
APP_PORT=8088
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_DATABASE=library_stroll
DB_USERNAME=library_stroll
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Bound to loopback, with ports different from the existing OpenServer services.
AI_API_PORT=8002
QDRANT_PORT=6335
PHPMYADMIN_PORT=8089
REVERB_PORT=8081
REVERB_APP_ID=docker-local-app
REVERB_APP_KEY=docker-local-key
REVERB_APP_SECRET=
VITE_REVERB_HOST=localhost
VITE_REVERB_SCHEME=http

AI_SERVICE_ENABLED=true
AI_ASSISTANT_ENABLED=true
# Optional LLM query normalization. RAG composition has its own flag.
AI_ASSISTANT_LLM_ENABLED=false
AI_ASSISTANT_RAG_ENABLED=true
AI_ASSISTANT_HISTORY_ENABLED=true
AI_ASSISTANT_CONTEXT_ENABLED=true
AI_ASSISTANT_INTENT_ROUTING_ENABLED=false
AI_ASSISTANT_DEBUG_ENABLED=false
AI_ASSISTANT_HISTORY_MAX_CONVERSATIONS=20
AI_ASSISTANT_HISTORY_MAX_TURNS=100
AI_ASSISTANT_HISTORY_MAX_QUERY_CHARS=500
AI_ASSISTANT_HISTORY_MAX_REFERENCE_BYTES=2048
AI_ASSISTANT_HISTORY_PAGE_SIZE=20
AI_ASSISTANT_LLM_TIMEOUT=15
AI_SERVICE_API_KEY=
AI_SERVICE_CONNECT_TIMEOUT=10
AI_SERVICE_RETRY_SLEEP=500
AI_PROCESSING_QUEUE=ai
AI_METADATA_SCHEMA_VERSION=1
AI_PROMPT_VERSION=1
AI_AUTO_ANALYZE_ON_PUBLISH=true
AI_AUTO_REINDEX_ON_UPDATE=true
AI_RERANK_ENABLED=false
AI_COLBERT_URL=
AI_COLBERT_TIMEOUT=0.5

# The research Compose file sets the sync URL and mounts the secret file.
AI_COLBERT_SYNC_ENABLED=false
AI_COLBERT_AUTO_SYNC_ENABLED=false
AI_COLBERT_SYNC_URL=
# Leave the key null when using the mounted secret file.
AI_COLBERT_SYNC_API_KEY=(null)
AI_COLBERT_SYNC_API_KEY_FILE=
AI_COLBERT_SYNC_CONNECT_TIMEOUT=0.25
AI_COLBERT_SYNC_TIMEOUT=2

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_VISION_TIMEOUT=45
OLLAMA_VISION_NUM_PREDICT=3072
OLLAMA_VISION_RETRY_NUM_PREDICT=4096
OLLAMA_VISION_RETRY_TIMEOUT=75
OLLAMA_VISION_RETRY_TEMPERATURE=0
OLLAMA_VISION_RETRY_NUM_CTX=8192
ARTWORK_ANALYSIS_TIMEOUT=165
OLLAMA_TEXT_TIMEOUT=100
OLLAMA_ASSISTANT_TIMEOUT=12
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_ALIVE=5m
QDRANT_COLLECTION=librarystroll_artworks

# Optional image overrides, e.g. immutable digest for a deployment.
OPENVERSE_ENABLED=false
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
SMITHSONIAN_ENABLED=false
SMITHSONIAN_API_KEY=
MYSQL_IMAGE=mysql:8.4
PHPMYADMIN_IMAGE=phpmyadmin:5.2-apache
REDIS_IMAGE=redis:7.4-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.18.0
OLLAMA_IMAGE=ollama/ollama:latest
