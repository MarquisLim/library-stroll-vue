# Separate Docker environment. Never copy OpenServer's .env over this file.
COMPOSE_PROJECT_NAME=library-stroll-docker
DOCKER_OLLAMA_MODE=host
APP_NAME=LibraryStroll
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8088
APP_PORT=8088
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_DATABASE=library_stroll
DB_USERNAME=library_stroll
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Bound to loopback, with ports different from the existing OpenServer services.
AI_API_PORT=8002
QDRANT_PORT=6335
PHPMYADMIN_PORT=8089
REVERB_PORT=8081
REVERB_APP_ID=docker-local-app
REVERB_APP_KEY=docker-local-key
REVERB_APP_SECRET=
VITE_REVERB_HOST=localhost
VITE_REVERB_SCHEME=http

AI_SERVICE_ENABLED=true
AI_SERVICE_API_KEY=
AI_PROCESSING_QUEUE=ai
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3-vl:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_VISION_TIMEOUT=45
OLLAMA_TEXT_TIMEOUT=100
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_ALIVE=5m
QDRANT_COLLECTION=librarystroll_artworks

# Optional image overrides, e.g. immutable digest for a deployment.
MYSQL_IMAGE=mysql:8.4
PHPMYADMIN_IMAGE=phpmyadmin:5.2-apache
REDIS_IMAGE=redis:7.4-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.18.0
OLLAMA_IMAGE=ollama/ollama:latest
