# ─────────────────────────────────────────────────────
# AI Service — Native Windows
# ─────────────────────────────────────────────────────
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001
AI_SERVICE_API_KEY=
# Semantic search requires a trusted Laravel visibility endpoint. Compose sets this automatically.
LARAVEL_INTERNAL_URL=

# ─────────────────────────────────────────────────────
# Ollama (running natively on Windows)
# ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_ALIVE=5m
OLLAMA_THINK=false
OLLAMA_NUM_PREDICT=768
OLLAMA_VISION_NUM_PREDICT=3072
OLLAMA_VISION_TIMEOUT=45
OLLAMA_VISION_RETRY_NUM_PREDICT=4096
OLLAMA_VISION_RETRY_TIMEOUT=75
OLLAMA_VISION_RETRY_TEMPERATURE=0
OLLAMA_VISION_RETRY_NUM_CTX=8192
ARTWORK_ANALYSIS_TIMEOUT=165
OLLAMA_TEXT_TIMEOUT=100
OLLAMA_ASSISTANT_TIMEOUT=12
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_LLM_ENABLED=false
AI_ASSISTANT_RAG_ENABLED=false
AI_ASSISTANT_CONTEXT_ENABLED=false

# ─────────────────────────────────────────────────────
# Qdrant (running in Docker on Windows)
# ─────────────────────────────────────────────────────
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=librarystroll_artworks
QDRANT_TIMEOUT=30

# ─────────────────────────────────────────────────────
# Schema versioning
# ─────────────────────────────────────────────────────
METADATA_SCHEMA_VERSION=1
PROMPT_VERSION=1

# ─────────────────────────────────────────────────────
# Docker variant (for future reference)
# ─────────────────────────────────────────────────────
# AI_SERVICE_HOST=0.0.0.0
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# QDRANT_URL=http://qdrant:6333          # if same Docker network
# QDRANT_URL=http://host.docker.internal:6333  # if separate
