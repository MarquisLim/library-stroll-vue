# ─────────────────────────────────────────────────────
# AI Service — Native Windows
# ─────────────────────────────────────────────────────
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001
AI_SERVICE_API_KEY=

# ─────────────────────────────────────────────────────
# Ollama (running natively on Windows)
# ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3-vl:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_ALIVE=5m

# ─────────────────────────────────────────────────────
# Qdrant (running in Docker on Windows)
# ─────────────────────────────────────────────────────
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=librarystroll_artworks
QDRANT_TIMEOUT=30

# ─────────────────────────────────────────────────────
# Schema versioning
# ─────────────────────────────────────────────────────
METADATA_SCHEMA_VERSION=1
PROMPT_VERSION=1

# ─────────────────────────────────────────────────────
# Docker variant (for future reference)
# ─────────────────────────────────────────────────────
# AI_SERVICE_HOST=0.0.0.0
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# QDRANT_URL=http://qdrant:6333          # if same Docker network
# QDRANT_URL=http://host.docker.internal:6333  # if separate
