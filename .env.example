APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=library_stroll_vue
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_CONNECTION=sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Real-time (Laravel Reverb + Echo). Run: php artisan reverb:start
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=local-app-id
REVERB_APP_KEY=local-app-key
REVERB_APP_SECRET=local-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Set to true when Reverb is running: php artisan reverb:start
VITE_REVERB_ENABLED=true

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=900
REDIS_QUEUE_BLOCK_FOR=5
DB_QUEUE_RETRY_AFTER=900

# FFmpeg/FFprobe can be executable names from PATH or explicit absolute paths.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Windows / Open Server example:
# FFMPEG_PATH=C:/OSPanel/modules/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/OSPanel/modules/ffmpeg/bin/ffprobe.exe

CACHE_STORE=redis
CACHE_PREFIX=cache:

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# OpenServer on Windows: REDIS_HOST=Redis (currently 127.0.1.25).
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=library_stroll:
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_LOCK_DB=3
REDIS_CACHE_LOCK_CONNECTION=locks
REDIS_CONNECT_TIMEOUT=3
REDIS_READ_TIMEOUT=10

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ───────────────────────────────────────────────
# AI Service
# ───────────────────────────────────────────────
AI_SERVICE_ENABLED=true
# Root Laravel profile: enable assistant features after configuring its FastAPI.
# The local Compose profile and its recommended flags are in docker/.env.example.
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_LLM_ENABLED=false
AI_ASSISTANT_RAG_ENABLED=false
AI_ASSISTANT_HISTORY_ENABLED=false
AI_ASSISTANT_CONTEXT_ENABLED=false
AI_ASSISTANT_DEBUG_ENABLED=false
AI_ASSISTANT_DEBUG_USER_IDS=
AI_ASSISTANT_HISTORY_MAX_CONVERSATIONS=20
AI_ASSISTANT_HISTORY_MAX_TURNS=100
AI_ASSISTANT_HISTORY_MAX_QUERY_CHARS=500
AI_ASSISTANT_HISTORY_MAX_REFERENCE_BYTES=2048
AI_ASSISTANT_HISTORY_PAGE_SIZE=20
AI_ASSISTANT_LLM_TIMEOUT=15
DEMO_CONTENT_USER_AGENT="LibraryStrollDemo/1.0 (local research catalog)"
OPENVERSE_ENABLED=false
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
SMITHSONIAN_ENABLED=false
SMITHSONIAN_API_KEY=
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT=180
AI_SERVICE_CONNECT_TIMEOUT=10
AI_SERVICE_RETRY_TIMES=2
AI_SERVICE_RETRY_SLEEP=500

# AI processing
AI_PROCESSING_QUEUE=ai
AI_METADATA_SCHEMA_VERSION=1
AI_PROMPT_VERSION=1
AI_AUTO_ANALYZE_ON_PUBLISH=true
AI_AUTO_REINDEX_ON_UPDATE=true
AI_RERANK_ENABLED=false
AI_COLBERT_URL=
AI_COLBERT_TIMEOUT=0.5

# Optional ColBERT document sync
AI_COLBERT_SYNC_ENABLED=false
AI_COLBERT_AUTO_SYNC_ENABLED=false
AI_COLBERT_SYNC_URL=
# Leave the key null when using a secret file.
AI_COLBERT_SYNC_API_KEY=(null)
AI_COLBERT_SYNC_API_KEY_FILE=
AI_COLBERT_SYNC_CONNECT_TIMEOUT=0.25
AI_COLBERT_SYNC_TIMEOUT=2
